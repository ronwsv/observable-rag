# ---- Provider selection -------------------------------------------------
# LLM backend: "ollama" (local, default), "openai", "anthropic", "bedrock", or "mock".
GAPRAG_LLM_PROVIDER=ollama
# Embedding backend: "sentence_transformers" (local), "openai", "bedrock", or "hash".
# "hash" needs no downloads and is used by tests/CI; swap to a semantic
# backend for real retrieval quality.
GAPRAG_EMBEDDING_PROVIDER=sentence_transformers
# Retrieval backend: "native" (FAISS directly) or "langchain" (LangChain's FAISS
# vectorstore). Same pipeline either way; native is the default. langchain needs
# the [langchain] extra.
GAPRAG_RETRIEVER=native

# ---- Models -------------------------------------------------------------
GAPRAG_LLM_MODEL=llama3.1:8b
GAPRAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Ollama -------------------------------------------------------------
GAPRAG_OLLAMA_BASE_URL=http://localhost:11434

# ---- AWS Bedrock (only for the bedrock provider) ------------------------
# Credentials use the standard AWS chain (env vars, ~/.aws/credentials, IAM role).
GAPRAG_AWS_REGION=us-east-1
# Example model ids:
#   LLM:        GAPRAG_LLM_MODEL=us.anthropic.claude-3-5-haiku-20241022-v1:0
#   Embeddings: GAPRAG_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# ---- API keys (only needed for the matching provider) -------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Retrieval ----------------------------------------------------------
GAPRAG_TOP_K=4
GAPRAG_CHUNK_SIZE=800
GAPRAG_CHUNK_OVERLAP=120

# ---- Observability ------------------------------------------------------
# Set to "1" to emit one structured JSON log line per request.
GAPRAG_JSON_LOGS=1
# Optional Langfuse tracing (needs the [langfuse] extra + keys).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
